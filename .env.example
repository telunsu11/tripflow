# ============================================================
# tripflow 配置样例 —— 复制为 .env 并填写（.env 已被 .gitignore 忽略，密钥永不入库）
# ============================================================

# ---- LLM（必填）任意 OpenAI 兼容端点 ----
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4/   （https://open.bigmodel.cn 申请）
# DeepSeek:  https://api.deepseek.com                （https://platform.deepseek.com 申请）
# 本地 Ollama: http://localhost:11434/v1             （Key 随便填一个非空串）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=
# 模型名以你的账号可用列表为准（示例：glm-4.7 / deepseek-chat）
LLM_MODEL=glm-4.7
# 轻任务（POI 提名等）可换便宜模型；留空则与 LLM_MODEL 相同
LLM_FAST_MODEL=

# ---- 高德（必填）----
# https://console.amap.com → 应用管理 → 创建新应用 → 添加 Key
# ⚠️ Key 类型必须选「Web服务」；REST 直连与高德云端 MCP 共用这一个 Key
AMAP_API_KEY=
# 可选：自定义高德 MCP 端点（留空默认 https://mcp.amap.com/mcp?key=<AMAP_API_KEY>）
AMAP_MCP_URL=

# ---- 12306（默认即可，一般无需修改）----
# 默认经 npx 本地拉起社区 MCP（需要已安装 Node.js：https://nodejs.org）
RAIL_MCP_MODE=stdio
RAIL_MCP_COMMAND=npx
RAIL_MCP_ARGS=-y 12306-mcp
# 换用远程 SSE 端点时改为：RAIL_MCP_MODE=sse 并填写 RAIL_MCP_URL
RAIL_MCP_URL=

# ---- 其它（可选）----
# 行程单输出目录
TRIP_OUTPUT_DIR=output
# 余票缓存秒数（避免高频打 12306 接口）
TRIP_TICKET_TTL=300
# 输出语言（预留 i18n）
TRIP_LANG=zh
